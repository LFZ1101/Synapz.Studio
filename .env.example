# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://synapz.studio

# Optional public contact channels
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=

# Contact form delivery (choose one)
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Analytics (install only after privacy review / consent)
# NEXT_PUBLIC_GA_ID=

# Admin panel (/admin) — private password, NOT used by public visitors
# Use a long random string (min 8 chars). Required to open the panel.
ADMIN_SECRET=

# Plataforma operacional (/plataforma)
# Segredo obrigatório para o bootstrap do proprietário (nunca use em público sem controle).
# Cadastro de owner só funciona com este token e enquanto não existir proprietário.
PLATFORM_BOOTSTRAP_SECRET=
# Segredo para assinar tokens de sessão (mín. 32 caracteres). Se vazio, deriva do bootstrap.
PLATFORM_SESSION_SECRET=
# Caminho opcional do SQLite (padrão: data/plataforma.db)
# PLATFORM_DB_PATH=
